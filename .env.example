# Environment variables for the I2Go employer portal (Next.js).
# NEXT_PUBLIC_* values are built into the browser bundle: never put secrets here.

# Supabase: same project as the mobile app (mobile_app/lib/constants/supabase_configs.dart)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key for the enquiry form. Leave empty until the
# TURNSTILE_SECRET_KEY secret is set on the submit-enquiry edge function.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical public address of the portal (server only, lib/seo/config.js).
# Leave unset on local and preview deployments: while it is unset every page
# is noindex and robots.txt blocks everything. Production:
# SITE_URL=https://i2go-jobportal.com
SITE_URL=

# Google Search Console meta-tag token (server only). Optional: leave empty if
# the domain is verified by a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=
